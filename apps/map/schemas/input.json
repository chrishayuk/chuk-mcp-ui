{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["type", "version", "layers"],
  "properties": {
    "type": { "const": "map" },
    "version": { "const": "1.0" },
    "center": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      },
      "required": ["lat", "lon"]
    },
    "zoom": { "type": "integer", "minimum": 1, "maximum": 22 },
    "bounds": {
      "type": "object",
      "properties": {
        "south": { "type": "number" },
        "west": { "type": "number" },
        "north": { "type": "number" },
        "east": { "type": "number" }
      },
      "required": ["south", "west", "north", "east"]
    },
    "basemap": { "enum": ["osm", "satellite", "terrain", "dark"] },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "layer_type": {
            "enum": ["geojson", "image", "tiles"],
            "description": "Layer renderer. Omit or set to 'geojson' for GeoJSON feature layers (default). Use 'image' for raster image overlays. Use 'tiles' for XYZ tile layers."
          },
          "visible": { "type": "boolean", "default": true },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "features": {
            "type": "object",
            "description": "GeoJSON FeatureCollection. Required when layer_type is 'geojson' (or omitted)."
          },
          "style": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "weight": { "type": "number" },
              "fillColor": { "type": "string" },
              "fillOpacity": { "type": "number" },
              "icon": { "type": "string" },
              "radius": { "type": "number" }
            }
          },
          "cluster": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "radius": { "type": "integer", "default": 50 }
            }
          },
          "popup": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "body": { "type": "string" },
              "fields": { "type": "array", "items": { "type": "string" } },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "tool", "arguments"],
                  "properties": {
                    "label": { "type": "string" },
                    "tool": { "type": "string" },
                    "arguments": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "confirm": { "type": "string" }
                  }
                }
              }
            }
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "Image URL for layer_type 'image'. The image is stretched to cover image_bounds."
          },
          "image_bounds": {
            "type": "array",
            "description": "Geographic bounds for image overlay: [[south_lat, west_lng], [north_lat, east_lng]].",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 2
          },
          "tile_url": {
            "type": "string",
            "description": "XYZ tile URL template for layer_type 'tiles', e.g. 'https://example.com/tiles/{z}/{x}/{y}.png'."
          },
          "tile_attribution": {
            "type": "string",
            "description": "Attribution string shown in the map attribution control."
          },
          "tile_min_zoom": {
            "type": "integer",
            "minimum": 0,
            "maximum": 22,
            "description": "Minimum zoom level at which tiles are loaded."
          },
          "tile_max_zoom": {
            "type": "integer",
            "minimum": 0,
            "maximum": 22,
            "description": "Maximum zoom level at which tiles are loaded."
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "properties": {
        "zoom": { "type": "boolean", "default": true },
        "layers": { "type": "boolean", "default": true },
        "scale": { "type": "boolean", "default": true },
        "fullscreen": { "type": "boolean", "default": false }
      }
    }
  }
}
